{
  "name": "@factory/droid-sdk",
  "version": "0.1.4",
  "private": false,
  "description": "TypeScript SDK for the Factory Droid CLI",
  "keywords": [
    "factory",
    "droid",
    "cli",
    "ai",
    "agent",
    "sdk"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ examples/",
    "fix": "eslint --fix src/ tests/ examples/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Factory-AI/droid-sdk-typescript.git"
  },
  "homepage": "https://github.com/Factory-AI/droid-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/Factory-AI/droid-sdk-typescript/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.1.0"
  }
}
